10 REM * FOR/NEXT Loop Demo *
20 CLS
30 REM === Basic Loop ===
40 PRINT "=== COUNT UP ==="
50 FOR I = 1 TO 5
60 PRINT I;
70 NEXT
80 PRINT ""
90 PAUSE 50
100 REM === STEP Demo ===
110 PRINT "=== STEP 2 ==="
120 FOR I = 0 TO 10 STEP 2
130 PRINT I;
140 NEXT
150 PRINT ""
160 PAUSE 50
170 REM === Countdown with STEP -1 ===
180 PRINT "=== COUNTDOWN ==="
190 FOR I = 3 TO 1 STEP -1
200 PRINT I; " ";
210 NEXT
220 PRINT "Go!"
230 PAUSE 50
240 REM === Nested Loops ===
250 PRINT "=== MULTIPLICATION ==="
260 FOR I = 1 TO 3
270 FOR J = 1 TO 3
280 LET P = I * J
290 PRINT I; "x"; J; "="; P; " ";
300 NEXT
310 PRINT ""
320 NEXT
330 PRINT "=== DONE ==="
340 END
