260 GOTO 60
270 X=MX-(S=1)*4+(S=2)*4:Y=MY-(S=4)*4+(S=8)*4:RETURN
280 X=PX-(S=1)*4+(S=2)*4:Y=PY-(S=4)*4+(S=8)*4:RETURN
