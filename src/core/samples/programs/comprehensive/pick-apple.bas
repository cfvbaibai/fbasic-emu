1 '一开始，屏幕上出现一条河，河中间有一竹，玛丽沃坐在竹筏上，抬头看着天上突然出现的30个苹果，张着大嘴要吃。当游戏者按下操纵器上“START”键时，他便腾空而起，去摘苹果。游戏者可用十字键控制玛丽沃左右移动，当玛丽沃下降时，游戏者必须控制其落到竹筏上，否则玛丽沃会掉入水中淹死!同时，竹筏会忽快忽慢的移动，还会忽
然调头。
2 '河两边有岸堤，但很滑，不能停留在上面。
3 '每摘一个苹果得3分，30个苹果共90分，当苹果摘完时，将奏一段音乐，并显示总分，总分=原得分十剩余命数X2。\
4 '当3条命用完时游戏结束，屏幕上显示“RE-PLAY?”字样时，按选择表示结束，开始键表示重新游戏。
5 SPRITE ON: CGSET 1, 2: RR = 20: VIEW: LOCATE 0, 22: PRINT "SCORE="
20 PALTEB 1, 14, 17, 17, 17: R = 4: FOR DE=0 TO 1: DEF SPRITE DE, (0, 1, 1, 0, 0) = CHR$(253) + CHR$(253) + CHR$(253) + CHR$(253): NEXT
40 X0 = 100: Y0 = 176: X1 = X0 + 16: SPRITE 0, X0, Y0: SPRITE 1, X1, Y0: DEF SPRITE 2, (0, 1, 1, 0, 0) = CHR$(24) + CHR$(25) + CHR$(26) + CHR$(27): X2 = 108: Y2 = 160: SPRITE 2, X2, Y2
60 PLAY "m1V4T1O2C3": PO = 3: IF STRIG(0) <> 1 THEN 60
62 PLAY "T1O3C1DEFGAB:T1C2DEGAB": IF STRIG(0) = 2 AND STICK(0) = 9 THEN R = 8: PO = 5
65 I = RND(34) + 64: LOCATE 0, 21: PRINT "PLAYER: "; PO
70 S = STICK(0): IF Y2 > I THEN Y2 = Y2 - R: GOTO 80
75 I = 176: Y2 = Y2 + 6
80 IF S = 2 X2 = X2 - R: IF X2 < 16 X2 = 16
90 IF S = 1 X2 = X2 + R: IF X2 > 226 X2 = 226
98 IF Q = 1 X0 = X0 + RND(8): GOTO 100
99 X0 = X0 - RND(8)
100 SPRITE 2, X2, Y2
101 IF X0 < 32 X0 = 32
102 IF X0 > 192 X0 = 192
105 SPRITE 0, X0, Y0: SPRITE 1, X0 + 16, Y0: B = B + 1: IF B = RR B = 0: Q = RND(2): RR = RND(50)
120 IF ABS(X0 + 8 - X2) < 20 AND Y2 >= 156 THEN I = RND(34) + 64
125 IF Y2 > 174 GOTO 900
130 IF Y2 > 152 AND X2 < 32 THEN Y2 = 160: X2 = 40
140 IF Y2 > 152 AND X2 > 216 THEN Y2 = 160: X2 = 208
150 D1 + (X2 - 16) / 18: D2 = D1 + 1: F = (Y2 - 24) / 8 : IF ASC(SCR$(D1, F)) = 215 OR ASC(SCR$(D2, F)) = 215 THEN PLAY "M1V15O3E1": SC = SC + 3: LOCATE 7, 22: PRINT SC: LOCATE D1, F: PRINT "  "
200 IF SC = 90 GOSUB 1000
300 GOTO 70
900 DEF SPRITE 4, (3, 1, 0, 0, 0) = CHR$(180) + CHR$(181) + CHR$(182) + CHR$(183): PALETS 3, 14, 2, 17, 17: SPRITE 4, X2, Y2 - 4: PLAY "T1B1AGFEDC5"
906 PO = PO - 1: IF PO > 0 THEN SPRITE 4: X2 = X0 + 8: Y2 = Y0 - 16: GOTO 65
910 FOR I = 0 TO 5: CLS: LOCATE 8, 11: PRINT "GAME OVER": NEXT
920 CLS: LOCATE 10, 10: PRINT "--GAME": LOCATE 12, 11: PRINT "OVER--"
930 PRINT: PRINT "", "   SCORE: "; SC + PO * 2: PRINT: PRINT "        REPLAY?"
940 IF STRIG(0) = 1 RUN
950 IF STRIG(0) = 2 SPRITE OFF: CLS: END
960 GOTO 940
1000 PLAY "M1V14Y3T3O2C3CC4E1G3GG4G1A3AA": PLAY "O3CO2G6R3F3FFAE3EEED3DDDG6": LOCATE 10, 23: PRINT: PRINT: PRINT: PRINT "        YOU WIN!!!": PAUSE 80: CLS: RETURN 930