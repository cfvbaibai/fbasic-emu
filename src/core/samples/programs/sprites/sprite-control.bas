10 REM * SPRITE CONTROL - 8 Directions *
20 REM Demonstrates all 8 movement directions:
30 REM  1=up  2=up-right  3=right  4=down-right
40 REM  5=down  6=down-left  7=left  8=up-left
50 CLS
60 SPRITE ON
70 REM Define 8 actions, one per direction
80 DEF MOVE(0)=SPRITE(0,1,15,120,0,0)
90 DEF MOVE(1)=SPRITE(0,2,15,120,0,0)
100 DEF MOVE(2)=SPRITE(0,3,15,120,0,0)
110 DEF MOVE(3)=SPRITE(0,4,15,120,0,0)
120 DEF MOVE(4)=SPRITE(0,5,15,120,0,0)
130 DEF MOVE(5)=SPRITE(0,6,15,120,0,0)
140 DEF MOVE(6)=SPRITE(0,7,15,120,0,0)
150 DEF MOVE(7)=SPRITE(0,8,15,120,0,0)
160 REM Direction 1: Up
170 POSITION 0,120,100
180 MOVE 0
190 PRINT "Direction 1: Up"
200 PAUSE 150
210 CUT 0
220 PRINT "X=";XPOS(0);" Y=";YPOS(0)
230 PAUSE 120
240 REM Direction 2: Up-Right
250 POSITION 0,80,120
260 MOVE 1
270 PRINT "Direction 2: Up-Right"
280 PAUSE 150
290 CUT 1
300 PRINT "X=";XPOS(1);" Y=";YPOS(1)
310 PAUSE 120
320 REM Direction 3: Right
330 POSITION 0,80,120
340 MOVE 2
350 PRINT "Direction 3: Right"
360 PAUSE 150
370 CUT 2
380 PRINT "X=";XPOS(2);" Y=";YPOS(2)
390 PAUSE 120
400 REM Direction 4: Down-Right
410 POSITION 0,80,120
420 MOVE 3
430 PRINT "Direction 4: Down-Right"
440 PAUSE 150
450 CUT 3
460 PRINT "X=";XPOS(3);" Y=";YPOS(3)
470 PAUSE 120
480 REM Direction 5: Down
490 POSITION 0,120,80
500 MOVE 4
510 PRINT "Direction 5: Down"
520 PAUSE 150
530 CUT 4
540 PRINT "X=";XPOS(4);" Y=";YPOS(4)
550 PAUSE 120
560 REM Direction 6: Down-Left
570 POSITION 0,160,80
580 MOVE 5
590 PRINT "Direction 6: Down-Left"
600 PAUSE 150
610 CUT 5
620 PRINT "X=";XPOS(5);" Y=";YPOS(5)
630 PAUSE 120
640 REM Direction 7: Left
650 POSITION 0,160,120
660 MOVE 6
670 PRINT "Direction 7: Left"
680 PAUSE 150
690 CUT 6
700 PRINT "X=";XPOS(6);" Y=";YPOS(6)
710 PAUSE 120
720 REM Direction 8: Up-Left
730 POSITION 0,160,120
740 MOVE 7
750 PRINT "Direction 8: Up-Left"
760 PAUSE 150
770 CUT 7
780 PRINT "X=";XPOS(7);" Y=";YPOS(7)
790 PAUSE 120
800 ERA 0
810 PRINT "All 8 directions done!"
820 END
