{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "scripts/validation/script-entrypoint-integrity.ts",
    "vite.config.runtime.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "src/**/__tests__/*",
    "src/core/parser/fbasic-parser.js"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "target": 3
  }
}
